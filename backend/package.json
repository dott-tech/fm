{
  "name": "driver-finance-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#prisma": {
      "types": "./src/generated/prisma/client.ts",
      "workerd": "./src/generated/prisma-worker/client.ts",
      "default": "./src/generated/prisma/client.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "build:web": "npm --prefix ../frontend run build",
    "cf:dev": "prisma generate && npm run build:web && wrangler dev",
    "deploy": "prisma generate && npm run build:web && wrangler deploy"
  },
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.22",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.161.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
