// Database schema. Run `npm run db:migrate` after changing it.
//
// Business rules are enforced in TWO places: the API (zod, friendly messages)
// and the database itself (CHECK constraints + a trigger, see the
// *_db_rules migration). Prisma can't express CHECK constraints, so they live
// in that migration's SQL; the comments on each model list them.
//
// Conventions:
// - Money is stored as whole numbers (Int) in the user's currency. IQD has no
//   decimals, so there are no rounding errors.
// - Entry dates are calendar days (@db.Date), not timestamps, so an entry
//   logged at 11pm never shifts to another day because of time zones.
// - Tables and columns are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  cab_driver
  delivery_rider
}

enum IncomeSource {
  cab
  delivery
  freelance
  other
}

enum ExpenseCategory {
  fuel
  oil_change
  repairs
  tyres
  phone_data
  bills // a fixed bill paid from a pot (installment, rent, ...)
  other
}

enum PotKind {
  bill // fixed amount due on a date, may repeat (car installment, rent)
  goal // savings goal or personal need (new tyres, Eid, emergency fund)
}

enum RepeatUnit {
  day
  week
  month
  year
}

// Shaped to match Better Auth's user table (string id, emailVerified, image),
// plus our own fields.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  // Guest mode (Better Auth anonymous plugin): true until they create an account.
  isAnonymous   Boolean  @default(false) @map("is_anonymous")
  role          Role     @default(cab_driver)
  currency      String   @default("IQD") @db.VarChar(3)
  // Weekly earnings goal after costs. Null = no target set yet.
  weeklyTarget  Int?     @map("weekly_target")
  // Regular days off, as weekday numbers (0 = Sunday ... 5 = Friday, 6 = Saturday).
  // Daily set-aside amounts are spread over working days only.
  daysOff       Int[]    @default([]) @map("days_off")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  incomeEntries IncomeEntry[]
  expenses      Expense[]
  pots          Pot[]
  daySkips      DaySkip[]

  @@map("users")
}

model IncomeEntry {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id")
  date        DateTime     @db.Date
  amount      Int
  hours       Decimal?     @db.Decimal(4, 2) // e.g. 7.50 hours
  orderCount  Int?         @map("order_count")
  tips        Int? // part of `amount` that was tips (amount is the total)
  // Part of `amount` the platform keeps (e.g. Baly 20%). A cost, like fuel.
  platformFee Int?         @map("platform_fee")
  platform    String?      @db.VarChar(50) // free text: Toters, Talabat, direct...
  source      IncomeSource
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every dashboard query is "this user's entries between two dates".
  @@index([userId, date])
  @@map("income_entries")
}

model Expense {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id")
  date      DateTime        @db.Date
  amount    Int
  category  ExpenseCategory
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("expenses")
}

// ---------- Auth tables (managed by Better Auth) ----------

// A logged-in device. The token lives in an httpOnly cookie in the browser.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// How a user logs in. For email + password, providerId is "credential" and
// password holds the hash (never the plain password). OAuth columns are here
// so Google login etc. can be added later without a schema change.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

// Short-lived codes (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------- Pots: money put aside day by day ----------

// A pot is something the driver puts money aside for: a fixed bill or a goal.
// How much is in it is not stored here: it's the sum of its transfers, so the
// history is complete and the balance can never drift out of sync.
model Pot {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id")
  kind         PotKind
  name         String      @db.VarChar(80)
  icon         String?     @db.VarChar(16)
  // Bill: the amount due. Goal: the amount needed.
  targetAmount Int         @map("target_amount")
  // Bill: next due date (required). Goal: optional deadline.
  dueDate      DateTime?   @map("due_date") @db.Date
  // Bills only: repeats every N units (e.g. 1 month). Null = one-off.
  repeatEvery  Int?        @map("repeat_every")
  repeatUnit   RepeatUnit? @map("repeat_unit")
  // Goals without a deadline: how much the driver chose to put aside per day.
  dailyAmount  Int?        @map("daily_amount")
  // Set when a one-off bill is paid or a goal is completed/closed.
  archivedAt   DateTime?   @map("archived_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfers PotTransfer[]

  @@index([userId, archivedAt])
  @@map("pots")
}

// Money moved into (+) or out of (-) a pot on a given day.
// Ownership comes from the pot (no user_id copy that could disagree with it).
model PotTransfer {
  id        String   @id @default(uuid()) @db.Uuid
  potId     String   @map("pot_id") @db.Uuid
  date      DateTime @db.Date
  amount    Int // positive = put aside, negative = taken out / spent
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  pot Pot @relation(fields: [potId], references: [id], onDelete: Cascade)

  @@index([potId, date])
  @@map("pot_transfers")
}

// A day the driver chose not to put money aside ("skip today"). The missed
// amount is spread over the remaining days automatically. One row per day.
model DaySkip {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("day_skips")
}
