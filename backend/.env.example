# Neon Postgres (Neon dashboard -> Connection details).
# Copy this file to .env and fill in real values. Never commit .env.

# Pooled connection (host contains "-pooler"): used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (same, without "-pooler"): used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

PORT=3000
