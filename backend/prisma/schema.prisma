// Database schema. Run `npm run db:migrate` after changing it.
// Conventions:
// - Money is stored as whole numbers (Int) in the user's currency. IQD has no
//   decimals, so there are no rounding errors.
// - Entry dates are calendar days (@db.Date), not timestamps, so an entry
//   logged at 11pm never shifts to another day because of time zones.
// - Tables and columns are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  cab_driver
  delivery_rider
}

enum IncomeSource {
  cab
  delivery
  freelance
  other
}

enum ExpenseCategory {
  fuel
  oil_change
  repairs
  tyres
  phone_data
  other
}

// Shaped to match Better Auth's user table (string id, emailVerified, image),
// plus our own fields.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          Role     @default(cab_driver)
  currency      String   @default("IQD") @db.VarChar(3)
  // Weekly earnings goal after costs. Null = no target set yet.
  weeklyTarget  Int?     @map("weekly_target")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  incomeEntries IncomeEntry[]
  expenses      Expense[]

  @@map("users")
}

model IncomeEntry {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id")
  date       DateTime     @db.Date
  amount     Int
  hours      Decimal?     @db.Decimal(4, 2) // e.g. 7.50 hours
  orderCount Int?         @map("order_count")
  tips       Int?
  platform   String?      @db.VarChar(50) // free text: Toters, Talabat, direct...
  source     IncomeSource
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every dashboard query is "this user's entries between two dates".
  @@index([userId, date])
  @@map("income_entries")
}

model Expense {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id")
  date      DateTime        @db.Date
  amount    Int
  category  ExpenseCategory
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("expenses")
}

// ---------- Auth tables (managed by Better Auth) ----------

// A logged-in device. The token lives in an httpOnly cookie in the browser.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// How a user logs in. For email + password, providerId is "credential" and
// password holds the hash (never the plain password). OAuth columns are here
// so Google login etc. can be added later without a schema change.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

// Short-lived codes (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
