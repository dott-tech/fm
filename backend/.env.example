# Neon Postgres (Neon dashboard -> Connection details).
# Copy this file to .env and fill in real values. Never commit .env.

# Pooled connection (host contains "-pooler"): used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (same, without "-pooler"): used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

PORT=3000

# Better Auth. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of this API (used to build auth URLs).
BETTER_AUTH_URL="http://localhost:3000"
# Where the frontend runs; requests from here are trusted (CSRF protection).
FRONTEND_URL="http://localhost:5173"
